# =============================================================================
# StageTechPro Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit .env.local to version control!

# -----------------------------------------------------------------------------
# Supabase Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (PRIVATE - only for server-side operations)
# WARNING: Never expose this in client code!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret (for token verification)
SUPABASE_JWT_SECRET=your-jwt-secret-here

# -----------------------------------------------------------------------------
# Site Configuration
# -----------------------------------------------------------------------------
# Your site URL (production: https://stagetechpro.online, local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=https://stagetechpro.online


# -----------------------------------------------------------------------------
# PayPal Subscriptions API Configuration (REQUIRED for payments) 
# -----------------------------------------------------------------------------
# Get these from: https://developer.paypal.com/dashboard/ (sandbox)
# or https://www.paypal.com/businessmanage/credentials/apiAccess (live)

# PayPal Environment: "sandbox" for testing, "live" for production
PAYPAL_ENV=sandbox

# PayPal REST API Credentials
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# PayPal Subscription Plan IDs
# Create these in PayPal Dashboard → Products & Subscriptions
PAYPAL_PRO_PLAN_ID=P-xxxxxxxxxxxxx
PAYPAL_TEAM_PLAN_ID=P-xxxxxxxxxxxxx

# PayPal Webhook ID
# Create webhook at: PayPal Dashboard → Webhooks
# Set URL to: https://yourdomain.com/api/paypal/webhook
# Subscribe to: BILLING.SUBSCRIPTION.* events
PAYPAL_WEBHOOK_ID=WH-xxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# EmailJS Configuration (Optional - for team invitations)
# -----------------------------------------------------------------------------
# Get these from: https://dashboard.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAILJS_INVITATION_TEMPLATE_ID=your_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key_here
